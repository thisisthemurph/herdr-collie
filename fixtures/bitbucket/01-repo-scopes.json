{
  "step": "01-repo-scopes",
  "description": "GET the repository; the token's scopes come back in headers",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.bitbucket.org/2.0/repositories/%5BWORKSPACE%5D/%5BREPO%5D",
        "body": null
      },
      "response": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "x-credential-type": "repo_access_token",
          "x-oauth-scopes": "pullrequest:write"
        },
        "body": {
          "type": "repository",
          "slug": "[REPO]",
          "mainbranch": {
            "name": "main"
          }
        }
      }
    }
  ]
}
